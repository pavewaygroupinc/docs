      "anchor": "Sandbox (Test)",
      "url": "https://api.viarosandbox.com/v1",
      "icon": "vial"
    },
    {
      "anchor": "Production (Live)",
      "url": "https://api.pursar.com/v1",
      "icon": "rocket"
    }
  ],
