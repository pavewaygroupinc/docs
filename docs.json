{
  "$schema": "https://mintlify.com/docs.json",
  "theme": "mint",
  "name": "Pursar Developer Portal",
  "colors": {
    "primary": "#635BFF",
    "light": "#7A73FF",
    "dark": "#0A2540"
  },
  "favicon": "/favicon.svg",
  "api": {
    "mdx": {
      "server": "https://api.viarosandbox.com/v1",
      "auth": {
        "method": "bearer"
      }
    },
    "playground": {
      "display": "interactive"
    }
